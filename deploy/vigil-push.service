[Unit]
Description=vigil - push the vault's pending commits
Documentation=file:///opt/vigil/repo/docs/guide.md
After=network-online.target
Wants=network-online.target
# A run that fails — the push failed or stalled past its timeout, or commits
# have waited longer than VIGIL_PUSH_ALERT_AFTER — starts the notification
# unit with this unit's name as its instance. deploy/vigil-notify@.service
# logs it at priority crit; how to make it mail or page instead is in
# docs/guide.md, "The push safety net".
OnFailure=vigil-notify@%N.service

[Service]
# Started by vigil-push.timer, or by hand: systemctl start vigil-push.service
Type=oneshot
User=vigil
Group=vigil
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# The same settings the server reads: the vault path, its remote and branch,
# and the two below. systemd reads the file as root and hands the values to
# the script in its environment; the file itself stays root's.
#   VIGIL_PUSH_TIMEOUT      seconds the push is given (default 120)
#   VIGIL_PUSH_ALERT_AFTER  minutes commits may wait unpushed (default 60)
EnvironmentFile=/etc/vigil/env
WorkingDirectory=/var/lib/vigil
# /run/vigil-push, created for the vigil user with mode 0700 for each run and
# removed after it: where the script takes its lock, so no other user can
# create or hold it.
RuntimeDirectory=vigil-push
RuntimeDirectoryMode=0700
ExecStart=/opt/vigil/repo/scripts/push_pending.sh
# The whole run, whatever the push's own timeout leaves: a remote that stalls
# fails the unit here at the latest.
TimeoutStartSec=5min
SyslogIdentifier=vigil-push

# ── Sandbox ──────────────────────────────────────────────────────────────
# From here to the end of [Service] the options are about the process, not
# about vigil: another unit that runs as the vigil user against the same state
# dir takes this block unchanged.
#
# Target: `systemd-analyze security vigil` at 3.0 or lower (docs/guide.md,
# Security model). setup.sh and update.sh --update-unit refuse a unit above it.

# Files. ReadWritePaths is the critical one: without it the service can write
# nowhere under ProtectSystem=strict, which produces exactly the
# permission-denied scenario the crash-safe write path was built to survive.
# The deploy key and known_hosts are read by the service, never written; the
# leading "-" lets the unit start on a host that has no .ssh yet.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/vigil
ReadOnlyPaths=-/var/lib/vigil/.ssh
# Everything the service creates is readable by the service user only: vault
# files, git objects, the dets files.
UMask=0077
# No core file either, for the same reason as ERL_CRASH_DUMP_SECONDS.
LimitCORE=0

# Privileges. No capabilities, and no way to gain any.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true

# Kernel and cgroups.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true

# Network. A Unix socket for the resolver, IPv4 and IPv6 for the loopback
# listener and for git over SSH to GitHub; no raw, packet or netlink sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# System calls. What an ordinary service needs, minus the privileged and the
# resource-control groups; a call outside the set fails with EPERM rather
# than killing the process.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# MemoryDenyWriteExecute stays off: the BEAM's JIT writes the code it then
# executes. Turn it on only after a boot and a write under it in the target
# container have shown it works.

