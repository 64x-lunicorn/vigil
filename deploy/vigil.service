[Unit]
Description=vigil - Markdown vault MCP server
After=network-online.target
Wants=network-online.target
# A release that cannot boot is restarted a few times and then left down,
# rather than restarted every second for ever: five failed starts in five
# minutes and the unit stays failed until someone looks.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vigil
Group=vigil
# Without a UTF-8 locale the BEAM treats filenames as raw bytes rather than
# Unicode: a vault note with non-ASCII characters in its filename is listed by
# File.ls, but File.read/cp then fails with "no such file or directory" on the
# very path File.ls just returned. C.UTF-8 is built into glibc, so no
# locale-gen is required. Found empirically on a fresh Debian 13 image.
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# No crash dump. The BEAM writes erl_crash.dump into the working directory,
# which is the state dir, and a dump holds every binary the node had in memory
# — the consent password, the SkillKey secret, bearer tokens.
Environment=ERL_CRASH_DUMP_SECONDS=0
# Where bin/vigil writes the runtime config it assembles at start. Its default
# is inside the release under /opt/vigil, which ProtectSystem=strict makes
# read-only; this /tmp is the unit's own (PrivateTmp) and is gone at stop.
Environment=RELEASE_TMP=/tmp
EnvironmentFile=/etc/vigil/env
WorkingDirectory=/var/lib/vigil
ExecStart=/opt/vigil/current/bin/vigil start
# Reaches the node over Erlang distribution, which the release binds to
# loopback and runs without epmd (rel/vm.args.eex).
ExecStop=/opt/vigil/current/bin/vigil stop
Restart=on-failure
RestartSec=1

# ── Sandbox ──────────────────────────────────────────────────────────────
# From here to the end of [Service] the options are about the process, not
# about vigil: another unit that runs as the vigil user against the same state
# dir takes this block unchanged.
#
# Target: `systemd-analyze security <this unit>` at 3.0 or lower
# (docs/guide.md, Security model). The scripts that install a unit with this
# block score it first and refuse it above the target: setup.sh and
# update.sh --update-unit for vigil.service, init.sh and update.sh for
# vigil-push.service.

# Files. ReadWritePaths is the critical one: without it the service can write
# nowhere under ProtectSystem=strict, which produces exactly the
# permission-denied scenario the crash-safe write path was built to survive.
# The deploy key and known_hosts are read by the service, never written; the
# leading "-" lets the unit start on a host that has no .ssh yet.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/vigil
ReadOnlyPaths=-/var/lib/vigil/.ssh
# Everything the service creates is readable by the service user only: vault
# files, git objects, the dets files.
UMask=0077
# No core file either, for the same reason as ERL_CRASH_DUMP_SECONDS.
LimitCORE=0

# Privileges. No capabilities, and no way to gain any.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true

# Kernel and cgroups.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true

# Network. A Unix socket for the resolver, IPv4 and IPv6 for the loopback
# listener and for git over SSH to GitHub; no raw, packet or netlink sockets.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# System calls. What an ordinary service needs, minus the privileged and the
# resource-control groups; a call outside the set fails with EPERM rather
# than killing the process.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# MemoryDenyWriteExecute stays off: the BEAM's JIT writes the code it then
# executes. Turn it on only after a boot and a write under it in the target
# container have shown it works.

[Install]
WantedBy=multi-user.target
