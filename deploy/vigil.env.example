# Target: /etc/vigil/env, 0600 root:root. Generated by scripts/init.sh — this
# file is reference documentation, not a template you need to copy.

VIGIL_VAULT_PATH=/var/lib/vigil/vault
VIGIL_PORT=4000
# Loopback unless a proxy on another host forwards to vigil. cloudflared on
# this host reaches 127.0.0.1; anything wider bypasses Cloudflare Access.
VIGIL_BIND=127.0.0.1
# The remote and the branch vigil pulls AND pushes, and the scripts read from
# here too (the push safety net, update.sh, verify()). Boot refuses a remote
# the vault clone does not have, and a branch it does not have or that does
# not track <remote>/<branch> (git branch -vv shows both).
# Unset, the remote is github and the branch is the clone's checked-out
# branch when that tracks a branch on the remote, main otherwise.
# scripts/init.sh writes both, as it found or created them.
VIGIL_GIT_REMOTE=github
VIGIL_GIT_BRANCH=main
VIGIL_TZ=Europe/Berlin
VIGIL_EXCLUDE=

# OAuth 2.1 (vigil is its own authorization server)
VIGIL_ISSUER=https://vault.example.org
VIGIL_RESOURCE=https://vault.example.org/mcp
VIGIL_AUTH_PASSWORD=changeme-min-12-chars
VIGIL_STATE_DIR=/var/lib/vigil

# Browser origins, besides the issuer's own, that may send a request to /mcp
# and the OAuth endpoints; comma-separated, scheme and host, no path. A request
# with no Origin (every MCP client that is a program) needs no entry. Leave it
# empty unless a browser-based client talks to vigil directly.
# VIGIL_ALLOWED_ORIGINS=http://localhost:6274

# The SkillKey HMAC secret: at least 32 random bytes, base64 or hex encoded,
# and never the consent password. Required — vigil refuses to boot without it.
# A host set up before this existed adds the line once, then restarts:
#   echo "VIGIL_SKILLKEY_SECRET=$(openssl rand -base64 48)" >> /etc/vigil/env
VIGIL_SKILLKEY_SECRET=replace-with-output-of-openssl-rand-base64-48

# Which address the OAuth rate limits and the consent lockout are keyed on.
# cloudflared on this host connects from loopback and overwrites
# CF-Connecting-IP with the real client's address, so loopback is the one peer
# whose header is believed. scripts/init.sh writes these two lines.
# Cloudflare's edge ranges are the wrong list for the tunnel: vigil never sees
# an edge address, so they never match. Name them only if the edge connects to
# vigil directly. Unset means "key on the peer of the TCP connection", which
# behind the tunnel is one global bucket anyone can use to lock the owner out.
# Setting them wrong is worse than leaving them unset: any caller that can
# reach vigil from a trusted address gets a fresh bucket per request by naming
# a new one. VIGIL_TRUSTED_PROXIES is a comma-separated list of addresses or
# CIDR blocks.
VIGIL_TRUSTED_PROXY_HEADER=CF-Connecting-IP
VIGIL_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# SkillKey rotation window and per-token rate limit
VIGIL_SKILLKEY_TTL=3600
VIGIL_RATE_LIMIT_RPM=60
# reload's own budget per access token, on top of the one above: each call
# pulls and reparses the whole vault inside the writer.
VIGIL_RELOAD_RATE_LIMIT_RPM=6

# The authorization server's own budgets, per client address per minute.
# /oauth/authorize and /oauth/token are given the same budget (they count
# separately — a bucket per endpoint per address); /oauth/register gets the
# tighter one, being rare and costing a dets row and an fsync per call.
VIGIL_OAUTH_RATE_LIMIT_RPM=30
VIGIL_OAUTH_REGISTER_RATE_LIMIT_RPM=5

# Wrong consent passwords per hour from every address together. Past it the
# consent form answers 429 for everyone until the hour is up, and a warning is
# logged. Each address is also locked out after 5 wrong in 15 minutes (an IPv6
# client per /64); this budget catches a guesser spread over many addresses.
VIGIL_CONSENT_FAILURES_PER_HOUR=50

# Shape the writing instructions handed to the MCP client on connect. These
# describe the vault, not the server: whose notes these are, and which language
# they are written in. vigil's own output is always English.
# Quoted: the value has a space, and the scripts `source` this file.
VIGIL_VAULT_OWNER="the vault owner"
VIGIL_VAULT_LANGUAGE="English"
