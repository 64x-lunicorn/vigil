#!/bin/sh
# Sourced by bin/vigil before every command — start, stop, rpc, remote.
#
# Erlang distribution stays on: it is how `bin/vigil stop`, `bin/vigil rpc`
# and the operator scripts reach the running node. What it must not do is
# listen beyond loopback, where it would be a way around Cloudflare Access for
# anyone holding the cookie. So the node gets a full name on 127.0.0.1, and
# rel/vm.args.eex binds its listener there and runs it without epmd; every
# command below agrees on the one port, so none of them needs epmd to find it.
#
# A full name rather than the default short one: a short name is resolved
# through the host name, which Debian maps to 127.0.1.1, and a listener on
# 127.0.0.1 is not reachable there.
RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_DISTRIBUTION

RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>}"
case "$RELEASE_NODE" in
  *@*) ;;
  *) RELEASE_NODE="${RELEASE_NODE}@127.0.0.1" ;;
esac
export RELEASE_NODE

# The distribution port. Leave it unset on a host: `bin/vigil rpc` run by an
# operator or a script does not read /etc/vigil/env, so a port set there would
# be one the service listens on and nothing else looks for. It exists so that
# scripts/test/release_smoke.sh can run beside another node.
VIGIL_DIST_PORT="${VIGIL_DIST_PORT:-4370}"
ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -erl_epmd_port ${VIGIL_DIST_PORT}"
export ELIXIR_ERL_OPTIONS
